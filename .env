# ==========================================
# CẤU HÌNH HỆ THỐNG FB GROUP ENGINE
# ==========================================

PORT=3001

# 1. Google Sheets Configuration
# URL của Google Sheet (Hỗ trợ định dạng CSV xuất bản hoặc link xem)
# Mặc định hỗ trợ liên kết chia sẻ hoặc link xuất bản CSV
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vQoBGFCfoHdH4aLxtXNtWt1bGP6r8mp89YGGjrLyrz0xa9YsQZWSEEmhDHwY_zSvtQPuQ1s3UMJ49KQ/pub?gid=1774117819&single=true&output=csv

# 2. Browser Stealth & Chrome Profile
CHROME_USER_DATA_DIR=./chrome_profile
CHROME_HEADLESS=false
CHROME_EXECUTABLE_PATH=

# 3. Delays & Safety Limits (Giãn cách an toàn tránh checkpoint)
MIN_DELAY_BETWEEN_POSTS_SEC=300
MAX_DELAY_BETWEEN_POSTS_SEC=600
MIN_TYPING_DELAY_MS=25
MAX_TYPING_DELAY_MS=85
MAX_POSTS_PER_DAY=25
